#include <iostream>
#include <string>
using namespace std;
 
int main() {
    string s;
    cin >> s;
 
    bool space = false;
 
    for (int i = 0; i < s.length(); ) {
 
        if (s.substr(i, 3) == "WUB") {
            space = true;
            i += 3;
        }
        else {
            if (space) {
                cout << " ";
                space = false;
            }
 
            cout << s[i];
            i++;
        }
    }
 
    return 0;
}
