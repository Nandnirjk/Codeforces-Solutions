#include <iostream>
#include <string>
using namespace std;

int main() {

    string s;
    getline(cin, s);

    int freq[26] = {0};

    for (int i = 0; i < s.length(); i++) {

        if (s[i] >= 'a' && s[i] <= 'z') {

            freq[s[i] - 'a'] = 1;
        }
    }

    int count = 0;

    for (int i = 0; i < 26; i++) {

        if (freq[i] == 1)
            count++;
    }

    cout << count;

    return 0;
}
